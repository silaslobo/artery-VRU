<?xml version="1.0" encoding="utf-8"?>
<services>
        <service type="artery.application.VaService">
        	<listener port="2018" />
        	<filters><name pattern="199.*" /></filters>
			<penetration rate="0.1" />
	</service>
	<service type="artery.application.CPServiceExt">
        <listener port="2018" />
		<listener port="2009" />
       	<filters>
			<name pattern="199.*" match="inverse" />
		</filters>
	</service>

	<service type="artery.application.EmergencyBrake">
        <listener port="2018" />
		<listener port="2009" />
       	<filters>
			<name pattern="VUT" />
		</filters>
	</service>	
	
</services>
