version 2
run envmod-0-20220922-15:23:30-272390
attr configname envmod
attr datetime 20220922-15:23:30
attr experiment envmod
attr inifile omnetpp.ini
attr iterationvars ""
attr iterationvarsf ""
attr measurement ""
attr network artery.envmod.World
attr processid 272390
attr repetition 0
attr replication #0
attr resultdir results
attr runnumber 0
attr seedset 0
param **.identityRegistryModule "\"idRegistry\""
param *.traci.mapper.vehicleType "\"artery.envmod.Car\""
param *.traci.mapper.PersonType "\"artery.envmod.Person\""
param *.environmentModel.drawObstacles true
param *.environmentModel.drawVehicles true
param *.environmentModel.drawPersons true
param *.environmentModel.obstacleTypes "\"building shop\""
param *.environmentModel.traciModule "\"traci\""
param *.environmentModel.nodeMobilityModule "\".mobility\""
param *.node[*].middleware.services "xmldoc(\"services-envmod.xml\")"
param *.node[*].environmentModel.sensors "xmldoc(\"sensors.xml\")"
param *.node[*].environmentModel.*.drawSensorCone true
param *.node[*].environmentModel.*.drawLinesOfSight true
param *.node[*].environmentModel.*.drawDetectedObjects true
param *.node[*].environmentModel.*.drawBlockingObstacles true
param *.node[*].environmentModel.*.drawDetectedPersons true
param *.node[*].environmentModel.*.doLineOfSightCheck true
param *.node[*].environmentModel.FrontLongRangeRadar.fovRange 150m
param *.node[*].environmentModel.FrontLongRangeRadar.fovAngle 10
param *.node[*].environmentModel.FrontShortRangeRadar.fovRange 65m
param *.node[*].environmentModel.FrontShortRangeRadar.fovAngle 80
param *.node[*].environmentModel.FrontShortRangeRadar.numSegments 4
param *.node[*].environmentModel.RearLongRangeRadar.fovRange 150m
param *.node[*].environmentModel.RearLongRangeRadar.fovAngle 10
param *.node[*].environmentModel.RearShortRangeRadar.fovRange 65m
param *.node[*].environmentModel.RearShortRangeRadar.fovAngle 80
param *.node[*].environmentModel.RearShortRangeRadar.numSegments 4
param *.node[*].environmentModel.SeeThrough.fovRange 10m
param **.vanetza[*].router.disableBeaconing true
param *.node[*].wlan[*].typename "\"VanetNic\""
param *.node[*].wlan[*].radio.channelNumber 180
param *.node[*].wlan[*].radio.carrierFrequency "5.9 GHz"
param *.node[*].wlan[*].radio.transmitter.power "200 mW"
param *.node[*].middleware.updateInterval 0.1s
param *.node[*].middleware.datetime "\"2018-03-19 10:00:00\""
param *.node[*].middleware.services "xmldoc(\"services.xml\")"
param World.traci.ignorePersons false
param *.traci.core.version -1
param *.traci.launcher.typename "\"PosixLauncher\""
param *.traci.launcher.sumocfg "\"crossing.sumocfg\""

scalar World.traci.launcher port 35845

